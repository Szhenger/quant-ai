# Copy to .env and adjust. All have working defaults for local dev.

DJANGO_SECRET_KEY=dev-insecure-key-change-in-production
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Postgres — the live system AND the tests (pytest-django creates an isolated
# test_<DB_NAME> database on the same server).
DB_NAME=quantai
DB_USER=quantai
DB_PASSWORD=quantai
DB_HOST=localhost
DB_PORT=5432

# Redis (Celery broker + Channels layer + shared cache/locks)
REDIS_URL=redis://localhost:6379/0

# Market data: auto | yfinance | synthetic
MARKETDATA_PROVIDER=auto

# Optional local Parquet bar cache (per-node disk, DuckDB-backed)
MARKETDATA_CACHE=False
# MARKETDATA_CACHE_DIR=.marketdata_cache
# MARKETDATA_CACHE_TTL=3600

# Fleet-wide shared bar cache in Redis (single-flight fetch coalescing).
MARKETDATA_SHARED_CACHE=True
# MARKETDATA_SHARED_CACHE_TTL=300
# MARKETDATA_SHARED_CACHE_SYNTHETIC_TTL=30
# MARKETDATA_FETCH_WAIT=10

# Evaluation fleet
# CELERY_CONCURRENCY=4
# CELERY_TASK_SOFT_TIME_LIMIT=210
# CELERY_TASK_TIME_LIMIT=240
# Consecutive failures before a strategy is auto-paused to FAILED.
# STRATEGY_MAX_CONSECUTIVE_FAILURES=5

# Account guards (see GET /api/v1/limits/)
# Strategies one workspace may hold; 0 = unlimited.
# STRATEGY_MAX_PER_WORKSPACE=50
# Paid AI calls per user per UTC day; exhaustion fails open (no-AI fallbacks).
# AI_DAILY_CALL_BUDGET=200

# Anthropic Claude (optional — without it, alerts fire on the quant condition only)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5
# ANTHROPIC_TIMEOUT_SECONDS=30

# Email (SMTP) alert channel — console backend is used automatically in DEBUG
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp.example.com
# EMAIL_HOST_USER=
# EMAIL_HOST_PASSWORD=
# EMAIL_TIMEOUT=10
# DEFAULT_FROM_EMAIL=alerts@quantai.local

# Frontend origin(s) for CORS
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
