# Copy to .env and adjust. All have working defaults for local dev.

DJANGO_SECRET_KEY=dev-insecure-key-change-in-production
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Postgres
DB_NAME=quantai
DB_USER=quantai
DB_PASSWORD=quantai
DB_HOST=localhost
DB_PORT=5432

# Redis (Celery broker + Channels layer)
REDIS_URL=redis://localhost:6379/0

# Market data: auto | yfinance | synthetic
MARKETDATA_PROVIDER=auto

# Anthropic Claude (optional — without it, alerts fire on the quant condition only)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-4-8

# Email (SMTP) alert channel — console backend is used automatically in DEBUG
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp.example.com
# EMAIL_HOST_USER=
# EMAIL_HOST_PASSWORD=
# DEFAULT_FROM_EMAIL=alerts@quantai.local

# Frontend origin(s) for CORS
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
